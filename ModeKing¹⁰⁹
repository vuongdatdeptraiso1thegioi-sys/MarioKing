local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Position = UDim2.fromOffset(15, y)
    button.Size = UDim2.new(1, -30, 0, 36)
    button.BackgroundColor3 = Color3.fromRGB(25, 40, 60)
    button.TextColor3 = Color3.fromRGB(230, 250, 255)
    button.Text = text
    button.TextSize = 15
    button.Font = Enum.Font.GothamSemibold
    button.AutoButtonColor = true
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = button

    button.Activated:Connect(function()
        callback(button)
    end)

    return button
end

local function toggleButton(name, y, callback)
    local enabled = false
    local button = makeButton(name .. ": OFF", y, function(b)
        enabled = not enabled
        b.Text = name .. (enabled and ": ON" or ": OFF")
        b.BackgroundColor3 = enabled
            and Color3.fromRGB(0, 105, 125)
            or Color3.fromRGB(25, 40, 60)

        callback(enabled)
    end)

    return button
end

-- Speed: áp dụng cho nhân vật trong trải nghiệm thử nghiệm của bạn
toggleButton("Speed Boost", 82, function(enabled)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = enabled and 32 or 16
    end
end)

toggleButton("Jump Boost", 124, function(enabled)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = enabled and 80 or 50
    end
end)

toggleButton("Infinite Jump", 166, function(enabled)
    -- Demo UI: nút ghi nhận trạng thái.
